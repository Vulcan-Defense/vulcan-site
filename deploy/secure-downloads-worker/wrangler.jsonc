{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vulcan-secure-downloads",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "routes": [
    { "pattern": "vulcandefense.com.br/business-products/portal*", "zone_name": "vulcandefense.com.br" },
    { "pattern": "www.vulcandefense.com.br/business-products/portal*", "zone_name": "vulcandefense.com.br" }
  ],
  "r2_buckets": [
    { "binding": "PACKAGES", "bucket_name": "vulcan-private-downloads" }
  ],
  "vars": {
    "DOWNLOAD_USERNAME": "cliente"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
